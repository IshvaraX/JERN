# Copy to .env. Loaded by main.py (saturday.utils.load_env) and referenced from mcp.json as ${NAME}.
# Only HF_TOKEN and HF_REPO are ever sent to the Colab VM.

# Hugging Face: keeps the trained LoRA adapter so Colab runs skip training. Token needs write access to the repo.
HF_REPO=your-user/jern
HF_TOKEN=

# weather tool (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# send_email tool (Gmail: use an app password); contacts live in data/contacts.json
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# MCP servers (mcp.json); a server whose secrets are unset is skipped
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EMAIL=
GOOGLE_MASTER_TOKEN=
YOUTUBE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_MAPS_API_KEY=
